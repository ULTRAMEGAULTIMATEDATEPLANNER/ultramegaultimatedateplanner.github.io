rules_version = '2';

// Someday Club: each list set lives at clubs/{club}/{films|dishes|together}/{item}.
// The club code is the private part of the share link (?club=...), so anyone with
// the link can read and edit that club, and nobody can list other clubs.
service cloud.firestore {
  match /databases/{database}/documents {

    function validClub(club) {
      return club.matches('^[A-Za-z0-9]{8,40}$');
    }

    function validList(list) {
      return list in ['films', 'dishes', 'together'];
    }

    function validItem(d) {
      return d.keys().hasOnly(['title', 'note', 'link', 'rank', 'done', 'doneAt', 'addedBy', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && d.note is string && d.note.size() <= 400
        && d.link is string && d.link.size() <= 2048
        && d.rank is number
        && d.done is bool
        && (d.doneAt == null || d.doneAt is number)
        && (d.addedBy == null || d.addedBy is string)
        && d.createdAt is number;
    }

    match /clubs/{club}/{list}/{item} {
      allow read, delete: if validClub(club) && validList(list);
      allow create, update: if validClub(club) && validList(list) && validItem(request.resource.data);
    }
  }
}
